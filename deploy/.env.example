# Public hostname; DNS must point at the VM for Let's Encrypt to work.
DOMAIN=notifier.example.org

POSTGRES_PASSWORD=change-me
# Or use an external database (e.g. Azure Database for PostgreSQL):
# DATABASE_URL=postgres://user:pass@host:5432/notifier?sslmode=require

# Bootstrap admin, created only if there are no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Bearer token for POST /api/ingest/page (generate with: openssl rand -hex 32)
INGEST_TOKEN=

# Prometheus metrics on :4101. Set METRICS_BIND to the VM's private IP so Prometheus can reach
# it (keep it off the public interface), and optionally require a bearer token.
# METRICS_BIND=10.0.0.4
# METRICS_TOKEN=
