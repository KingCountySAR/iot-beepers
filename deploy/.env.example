# Public hostname; DNS must point at the VM for Let's Encrypt to work.
DOMAIN=notifier.example.org

POSTGRES_PASSWORD=change-me
# Or use an external database (e.g. Azure Database for PostgreSQL):
# DATABASE_URL=postgres://user:pass@host:5432/notifier?sslmode=require

# Admins: comma-separated Google account emails.
SITE_ADMINS=
# Google Workspace domains whose accounts can sign in (comma-separated, e.g. kcesar.org). Empty:
# any Google account the member database knows, personal ones included.
ALLOWED_DOMAINS=

# Member database: cedar, which says who people are and which D4H groups they're in.
# See docs/members.md. A client_credentials client from cedar's Hydra with scope members.read:
MEMBER_API_URL=http://cedar:3040/api/v1
MEMBER_API_TOKEN_URL=
MEMBER_API_CLIENT_ID=
MEMBER_API_CLIENT_SECRET=
# MEMBER_API_SCOPE=members.read
# MEMBER_SYNC_HOURS=24

# "Sign in with Google": a Web application OAuth client's ID from Google Cloud Console, with
# https://<DOMAIN> as an Authorized JavaScript origin. No secret needed. See README.md.
GOOGLE_CLIENT_ID=

# Bearer token for POST /api/ingest/page (generate with: openssl rand -hex 32)
INGEST_TOKEN=

# Prometheus metrics on :4101. Set METRICS_BIND to the VM's private IP so Prometheus can reach
# it (keep it off the public interface), and optionally require a bearer token.
# METRICS_BIND=10.0.0.4
# METRICS_TOKEN=
