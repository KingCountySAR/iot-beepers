# The pager server's settings on the KCSARA VM: copy to /srv/kcsara/apps/beepers/config/app.env there (a copy of this
# file is in apps/beepers/current after a deploy). Never commit the real file: it has the ingest token and cedar's
# client secret. server/src/config.ts has every setting. DATABASE_URL is in database.env, from
# `node deploy.mjs database beepers` in the vm repo.

# The site's address, as pagers and browsers reach it: pagers connect to wss://<this host>/mqtt and fetch OTA updates
# from it. The same as the host in HOSTS, on a test VM.
PUBLIC_URL=https://beepers.kingcountysar.org

# Admins: comma-separated Google account emails. They can always sign in.
SITE_ADMINS=
# Google Workspace domains whose accounts can sign in, comma separated (e.g. kcesar.org).
ALLOWED_DOMAINS=

# "Sign in with Google": a Web application OAuth client's ID from Google Cloud Console, with PUBLIC_URL as an
# Authorized JavaScript origin. No secret needed. See "Sign-in" in README.md.
GOOGLE_CLIENT_ID=

# Member database: cedar, over the kcsara network (MEMBER_API_URL and MEMBER_API_TOKEN_URL are in compose.yaml). A
# client_credentials client with scope members.read, from the vm repo:
#   node hydra.mjs create oauth2-client --name beepers --grant-type client_credentials --scope members.read --format json
MEMBER_API_CLIENT_ID=
MEMBER_API_CLIENT_SECRET=
# MEMBER_API_SCOPE=members.read
# MEMBER_SYNC_HOURS=24

# Bearer token for POST /api/ingest/page (openssl rand -hex 32). Ingest is off when unset.
# The VM's mail service sends email pages with it too (ROUTE_BEEPERS_TOKEN in its config/mail.env).
INGEST_TOKEN=
