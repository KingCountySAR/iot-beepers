{
  "name": "@sar-notifier/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file=dev.env --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "aedes": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "11.2.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "mqtt": "^5.16.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
