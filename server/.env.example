# Copy to server/.env.local for `npm run dev`. Without DATABASE_URL an embedded PGlite DB in ./data is used.
INGEST_TOKEN=dev-ingest-token

# Admins: comma-separated Google account emails. They can always sign in.
SITE_ADMINS=you@example.com
# Google accounts at these domains can sign in.
ALLOWED_DOMAINS=example.com

# Member database: cedar (docs/members.md). Without it each email is its own member, with no
# groups, so only direct grants give access. For a local cedar and Hydra (see cedar's README):
# MEMBER_API_URL=http://localhost:3040/api/v1
# MEMBER_API_TOKEN_URL=http://localhost:4444/oauth2/token
# MEMBER_API_CLIENT_ID=
# MEMBER_API_CLIENT_SECRET=

# Sign in by typing an email instead of going through Google. Dev only; refused on https.
DEV_LOGIN=true

# Real Google sign-in in dev: the OAuth client's Authorized JavaScript origins must include
# http://localhost:4100 (Google allows plain HTTP only for localhost, so sign in there).
# GOOGLE_CLIENT_ID=

# Devices on your LAN need to reach the server, so use the machine's LAN IP, not localhost:
# PUBLIC_URL=http://192.168.1.20:4100

# DATABASE_URL=postgres://notifier:notifier@localhost:5432/notifier
