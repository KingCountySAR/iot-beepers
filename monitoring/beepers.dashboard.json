        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(sar_devices{app=\"beepers\",paired=\"true\",online=\"true\"}) or 0 * sum(sar_devices{app=\"beepers\",paired=\"true\"})",
          "legendFormat": "Connected"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(sar_devices{app=\"beepers\",paired=\"true\",online=\"false\"}) or 0 * sum(sar_devices{app=\"beepers\",paired=\"true\"})",
          "legendFormat": "Not connected"
        }
      ],
