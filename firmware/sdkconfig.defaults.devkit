# Profile: ESP32 DevKit V1 (classic ESP32-WROOM-32) for prototyping on a breadboard.
# Layered on top of sdkconfig.defaults; see README.md for the build command.
CONFIG_IDF_TARGET="esp32"
CONFIG_NOTIFIER_BOARD="devkit-v1"

# GPIO 6-11 are the flash chip, 1/3 are the console, 34-39 are input-only with no pull-ups.
CONFIG_NOTIFIER_ALARM_GPIO=25
# Passive buzzer modules with a PNP transistor (S8550, marked 2TY) sound when the pin is low.
CONFIG_NOTIFIER_ALARM_ACTIVE_LOW=y
# The on-board BOOT button. GPIO0 is a strapping pin: holding it during reset enters the bootloader.
CONFIG_NOTIFIER_BUTTON_GPIO=0
CONFIG_NOTIFIER_BUTTON_ALT_GPIO=-1
CONFIG_NOTIFIER_SWITCH_GPIO=27
# The on-board blue LED stands in for the green status LED.
CONFIG_NOTIFIER_STATUS_LED_GPIO=2
CONFIG_NOTIFIER_ALERT_LED_GPIO=4
